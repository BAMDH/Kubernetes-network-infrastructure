FROM httpd:2.4

# Enable required Apache modules for reverse proxy
# These modules must be loaded for ProxyPass / ProxyPassReverse to work
RUN sed -i \
    -e 's/^#LoadModule proxy_module/LoadModule proxy_module/' \
    -e 's/^#LoadModule proxy_http_module/LoadModule proxy_http_module/' \
    -e 's/^#LoadModule proxy_balancer_module/LoadModule proxy_balancer_module/' \
    -e 's/^#LoadModule slotmem_shm_module/LoadModule slotmem_shm_module/' \
    -e 's/^#LoadModule lbmethod_byrequests_module/LoadModule lbmethod_byrequests_module/' \
    conf/httpd.conf

# Copy your custom Apache configuration files
# (assuming they are in the same directory as this Dockerfile)
COPY ./httpd.conf /usr/local/apache2/conf/httpd.conf
COPY ./httpd-vhosts.conf /usr/local/apache2/conf/extra/httpd-vhosts.conf

# Expose port 80
EXPOSE 80

# Start Apache in the foreground (default CMD from base image)
